{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!r/|previews/|sponsors/|assets/|icon\.svg|peel-logo\.svg|peel-logo\.png|llms\.txt|robots\.txt|sitemap\.xml).*)",
      "destination": "/index.html"
    }
  ]
}
